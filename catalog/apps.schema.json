{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RCK App",
  "type": "object",
  "required": ["id", "name", "description", "subcategory"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^apps\\.[a-z0-9-]+$",
      "description": "Formato apps.nombre-app"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 5
    },
    "subcategory": {
      "type": "string",
      "enum": ["browsers", "dev-tools", "utilities", "media", "communication", "gaming", "security", "networking", "productivity"]
    },
    "winget": {
      "type": "string",
      "description": "Package identifier de winget (winget search / winget show)."
    },
    "choco": {
      "type": "string",
      "description": "Nombre del paquete en Chocolatey (choco search)."
    }
  },
  "additionalProperties": false
}
