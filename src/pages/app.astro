---
import "../styles/global.css";
import {
  TWEAK_CATEGORIES,
  APP_SUBCATEGORIES,
  tweaksByCategory,
  appsBySubcategory,
  tools,
  presets,
} from "../lib/catalog";

const CATEGORY_LABELS: Record<string, string> = {
  debloat: "Debloat",
  privacy: "Privacidad",
  performance: "Rendimiento",
  services: "Servicios",
  network: "Red",
  appearance: "Apariencia",
  updates: "Actualizaciones",
  system: "Sistema",
};

const CATEGORY_ICONS: Record<string, string> = {
  debloat: "🧹",
  privacy: "🔒",
  performance: "⚡",
  services: "⚙️",
  network: "🌐",
  appearance: "🎨",
  updates: "🔄",
  system: "🖥️",
};

const SUBCATEGORY_LABELS: Record<string, string> = {
  browsers: "Navegadores",
  "dev-tools": "Herramientas de desarrollo",
  utilities: "Utilidades",
  media: "Multimedia",
  communication: "Comunicación",
  gaming: "Gaming",
  security: "Seguridad",
  networking: "Redes",
  productivity: "Ofimática",
};
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>RCK — Constructor</title>
  </head>
  <body>
    <div class="layout">
      <aside class="sidebar">
        <div class="sidebar__brand">🛡️ RCK</div>
        <button class="sidebar__uncheck" id="uncheck-all">Desmarcar todo</button>

        <div class="sidebar__item active" data-panel-target="inicio">
          <span class="sidebar__item-icon">🏠</span> Inicio
        </div>
        <div class="sidebar__item" data-panel-target="presets">
          <span class="sidebar__item-icon">⭐</span> Presets
        </div>

        <div class="sidebar__section-label">Tweaks</div>
        {TWEAK_CATEGORIES.map((cat) => (
          <div class="sidebar__item" data-panel-target={`cat-${cat}`}>
            <span class="sidebar__item-icon">{CATEGORY_ICONS[cat]}</span> {CATEGORY_LABELS[cat]}
          </div>
        ))}

        <div class="sidebar__section-label">Extras</div>
        <div class="sidebar__item" data-panel-target="apps">
          <span class="sidebar__item-icon">📦</span> Apps
        </div>
        <div class="sidebar__item" data-panel-target="tools">
          <span class="sidebar__item-icon">🛠️</span> Herramientas
        </div>
        <div class="sidebar__item" data-panel-target="services">
          <span class="sidebar__item-icon">🧰</span> Servicios
        </div>
        <div class="sidebar__item" data-panel-target="installed-apps">
          <span class="sidebar__item-icon">💾</span> Apps instaladas
        </div>
        <div class="sidebar__item" data-panel-target="script">
          <span class="sidebar__item-icon">📜</span> Ver Script
        </div>
      </aside>

      <main class="main">
        <!-- Inicio -->
        <section class="panel" data-panel="inicio">
          <div class="main__header">
            <h1>Inicio</h1>
          </div>
          <div class="stat-grid" id="system-info-grid">
            <div class="stat-card">
              <div class="stat-card__label">Estado</div>
              <div class="stat-card__value" id="system-info-status">Cargando…</div>
            </div>
          </div>
          <div class="stat-grid" id="live-metrics-grid">
            <div class="stat-card">
              <div class="stat-card__label">🧠 Procesador</div>
              <div class="stat-card__value" id="metric-cpu">—</div>
            </div>
            <div class="stat-card">
              <div class="stat-card__label">📊 Memoria</div>
              <div class="stat-card__value" id="metric-ram">—</div>
            </div>
            <div class="stat-card">
              <div class="stat-card__label">🌐 Red</div>
              <div class="stat-card__value" id="metric-network">—</div>
            </div>
          </div>
          <div class="stat-grid">
            <div class="stat-card">
              <div class="stat-card__label">🧩 Tweaks disponibles</div>
              <div class="stat-card__value">{TWEAK_CATEGORIES.map((c) => tweaksByCategory(c).length).reduce((a, b) => a + b, 0)}</div>
            </div>
            <div class="stat-card">
              <div class="stat-card__label">📦 Apps disponibles</div>
              <div class="stat-card__value">{APP_SUBCATEGORIES.map((s) => appsBySubcategory(s).length).reduce((a, b) => a + b, 0)}</div>
            </div>
            <div class="stat-card">
              <div class="stat-card__label">🛠️ Herramientas</div>
              <div class="stat-card__value">{tools.length}</div>
            </div>
          </div>
          <p style="color: var(--text-dim);">
            Elige una categoría en la barra lateral para empezar, o usa un <strong>Preset</strong> para partir de una
            selección ya pensada. Todo lo que marques se puede revisar en <strong>Ver Script</strong> antes de aplicarlo.
          </p>
        </section>

        <!-- Presets -->
        <section class="panel" data-panel="presets" hidden>
          <div class="main__header">
            <h1>⭐ Presets</h1>
            <span class="main__count">Reemplazan tu selección actual</span>
          </div>
          <div class="tweak-list">
            {presets.map((preset) => (
              <div class="tweak-card" data-preset-id={preset.id}>
                <div class="tweak-card__body">
                  <div class="tweak-card__title">{preset.name}</div>
                  <p class="tweak-card__desc">{preset.description}</p>
                  <p class="tweak-card__desc" style="font-size: 0.78rem;">
                    {preset.tweaks.length} tweak(s) · {preset.apps.length} app(s) · {preset.tools.length} herramienta(s)
                  </p>
                </div>
                <div class="tweak-card__actions">
                  <button class="button button--primary" data-apply-preset={preset.id}>Aplicar preset</button>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Categorías de tweaks -->
        {TWEAK_CATEGORIES.map((cat) => (
          <section class="panel" data-panel={`cat-${cat}`} hidden>
            <div class="main__header">
              <h1>{CATEGORY_ICONS[cat]} {CATEGORY_LABELS[cat]}</h1>
              <span class="main__count">
                {tweaksByCategory(cat).length} tweak(s)
                <button class="button" data-refresh-status={`cat-${cat}`} style="margin-left: 0.5rem; padding: 0.2rem 0.6rem; font-size: 0.75rem;">🔄 Estado</button>
              </span>
            </div>
            <div class="tweak-list">
              {tweaksByCategory(cat).length === 0 && <p style="color: var(--text-dim);">Todavía no hay tweaks en esta categoría.</p>}
              {tweaksByCategory(cat).map((tweak) => (
                <div class="tweak-card" data-tweak-id={tweak.id}>
                  <div class="tweak-card__body">
                    <div class="tweak-card__title">{tweak.id}</div>
                    <div class="tweak-card__meta">
                      <span class={`risk-badge risk-badge--${tweak.risk}`}>{tweak.risk}</span>
                      {tweak.requires_restart && <span class="restart-hint" title="Requiere reinicio">↻ reinicio</span>}
                      <span class="risk-badge risk-badge--neutral" data-status-tweak={tweak.id} hidden></span>
                    </div>
                    <p class="tweak-card__desc">{tweak.description}</p>
                  </div>
                  <div class="tweak-card__actions">
                    <label class="switch">
                      <input type="checkbox" data-select-tweak={tweak.id} />
                      <span class="switch__track"></span>
                    </label>
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))}

        <!-- Apps -->
        <section class="panel" data-panel="apps" hidden>
          <div class="main__header">
            <h1>📦 Apps</h1>
            <button class="button" data-refresh-status="apps" style="padding: 0.3rem 0.75rem; font-size: 0.8rem;">🔄 Estado</button>
          </div>
          {APP_SUBCATEGORIES.map((sub) => (
            <div>
              <h3>{SUBCATEGORY_LABELS[sub]}</h3>
              <div class="tweak-list">
                {appsBySubcategory(sub).map((app) => (
                  <div class="tweak-card" data-app-id={app.id}>
                    <div class="tweak-card__body">
                      <div class="tweak-card__title">
                        {app.name}
                        <span class="risk-badge risk-badge--neutral" data-status-app={app.id} hidden></span>
                      </div>
                      <p class="tweak-card__desc">{app.description}</p>
                    </div>
                    <div class="tweak-card__actions">
                      <label class="switch">
                        <input type="checkbox" data-select-app={app.id} />
                        <span class="switch__track"></span>
                      </label>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </section>

        <!-- Herramientas -->
        <section class="panel" data-panel="tools" hidden>
          <div class="main__header">
            <h1>🛠️ Herramientas</h1>
            <span class="main__count">Acciones puntuales, sin estado</span>
          </div>
          <div class="tweak-list">
            {tools.map((tool) => (
              <div class="tweak-card" data-tool-id={tool.id}>
                <div class="tweak-card__body">
                  <div class="tweak-card__title">{tool.name}</div>
                  <div class="tweak-card__meta">
                    <span class={`risk-badge risk-badge--${tool.risk}`}>{tool.risk}</span>
                  </div>
                  <p class="tweak-card__desc">{tool.description}</p>
                </div>
                <div class="tweak-card__actions">
                  <label class="switch">
                    <input type="checkbox" data-select-tool={tool.id} />
                    <span class="switch__track"></span>
                  </label>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Servicios -->
        <section class="panel" data-panel="services" hidden>
          <div class="main__header">
            <h1>🧰 Servicios</h1>
            <span class="main__count" id="services-count">
              <button class="button" id="services-refresh" style="padding: 0.3rem 0.75rem; font-size: 0.8rem;">🔄 Actualizar</button>
            </span>
          </div>
          <p style="color: var(--text-dim); font-size: 0.85rem;">
            Lectura en vivo de <code>Get-Service</code>, no del catálogo firmado. Los servicios protegidos (ver
            <code>docs/BLACKLIST.md</code>) se muestran pero RCK rechaza cualquier cambio sobre ellos. Solo se puede
            cambiar el <strong>tipo de inicio</strong> — no hay start/stop en caliente desde aquí.
          </p>
          <input type="text" id="services-search" placeholder="Buscar servicios..." class="services-search" />
          <div id="services-list" class="tweak-list">
            <p style="color: var(--text-dim);">Pulsa 🔄 Actualizar para cargar la lista de servicios.</p>
          </div>
        </section>

        <!-- Apps instaladas -->
        <section class="panel" data-panel="installed-apps" hidden>
          <div class="main__header">
            <h1>💾 Apps instaladas</h1>
            <span class="main__count" id="installed-apps-count">
              <button class="button" id="installed-apps-refresh" style="padding: 0.3rem 0.75rem; font-size: 0.8rem;">🔄 Actualizar</button>
            </span>
          </div>
          <p style="color: var(--text-dim); font-size: 0.85rem;">
            Todo lo que Windows ya tiene instalado (igual que "Aplicaciones y características"), leído de las claves
            de registro <code>Uninstall</code> — distinto del catálogo de <strong>Apps</strong>, que es para instalar
            cosas nuevas. Desinstalar aquí ejecuta el desinstalador original del propio programa.
          </p>
          <input type="text" id="installed-apps-search" placeholder="Buscar apps instaladas..." class="services-search" />
          <div id="installed-apps-list" class="tweak-list">
            <p style="color: var(--text-dim);">Pulsa 🔄 Actualizar para cargar las apps instaladas.</p>
          </div>
        </section>

        <!-- Ver Script -->
        <section class="panel" data-panel="script" hidden>
          <div class="main__header">
            <h1>📜 Ver Script</h1>
          </div>
          <p style="color: var(--text-dim);">
            Así se ve el <code>.ps1</code> que se generaría con tu selección actual. Puedes editarlo libremente —
            quitar líneas, añadir las tuyas — y luego ejecutar exactamente lo que hayas escrito.
          </p>
          <div class="tweak-card__actions" style="margin-bottom: 0.75rem;">
            <button class="button" id="copy-script">Copiar</button>
            <button class="button" id="download-script">Descargar .ps1</button>
            <button class="button" id="export-profile">Exportar selección (.json)</button>
            <button class="button" id="import-profile">Importar selección (.json)</button>
            <input type="file" id="import-profile-input" accept="application/json" hidden />
          </div>
          <div class="tweak-card__actions" style="margin-bottom: 0.75rem;">
            <button class="button" id="export-winscript">Exportar como WinScript (.json)</button>
            <button class="button" id="import-winscript">Importar perfil de WinScript (.json)</button>
            <input type="file" id="import-winscript-input" accept="application/json" hidden />
          </div>
          <p style="color: var(--text-dim); font-size: 0.85rem;">
            RCK entiende los perfiles <code>.json</code> exportados por WinScript (claves planas
            <code>"clave": true/false</code>). La correspondencia no es 1:1 perfecta — al importar verás cuántas
            claves se reconocieron y cuáles no tienen equivalente todavía.
          </p>
          <textarea class="script-preview" id="script-preview" spellcheck="false" rows="18">Selecciona algún tweak, app o herramienta para ver el script aquí.</textarea>
          <div class="tweak-card__actions" style="margin-top: 0.75rem;">
            <button class="button" id="regenerate-script">↻ Regenerar desde selección</button>
            <button class="button button--primary" id="run-script" hidden>▶ Ejecutar en este PC</button>
          </div>
          <p class="script-warning" id="run-script-warning" hidden>
            ⚠️ Esto ejecuta exactamente el texto de arriba, tal cual, con permisos de administrador. No pasa por la
            lista negra de tweaks ni por la firma del catálogo — solo se comprueba contra los mismos patrones
            catastróficos prohibidos en todo RCK (<code>guard.rs</code>: takeown/icacls/bcdedit, borrados bajo
            System32...). Revísalo antes de pulsar.
          </p>
          <pre class="script-preview" id="run-script-output" hidden></pre>
        </section>

        <div class="action-bar" id="action-bar">
          <span id="selection-count">0 seleccionados</span>
          <button id="action-button" disabled>Selecciona al menos un elemento</button>
        </div>
      </main>
    </div>

    <script>
      import { isDesktop } from "../lib/runtime";
      import { tweaks, apps, tools, presets } from "../lib/catalog";
      import { buildScript, downloadScript } from "../lib/scriptBuilder";
      import { desktop } from "../lib/tauriClient";
      import type { PackageManager } from "../lib/types";
      import { isWinScriptProfile, importWinScriptProfile, exportWinScriptProfile } from "../lib/winscriptCompat";

      const desktopMode = isDesktop();
      const selectedTweaks = new Set<string>();
      const selectedApps = new Set<string>();
      const selectedTools = new Set<string>();

      function preferredManager(app: (typeof apps)[number]): PackageManager {
        return app.winget ? "winget" : "choco";
      }

      function currentSelection() {
        return {
          tweaks: tweaks.filter((t) => selectedTweaks.has(t.id)),
          apps: apps
            .filter((a) => selectedApps.has(a.id))
            .map((app) => ({ app, manager: preferredManager(app) })),
          tools: tools.filter((t) => selectedTools.has(t.id)),
        };
      }

      // El textarea de "Ver Script" se regenera automáticamente al cambiar
      // la selección — salvo que el usuario ya lo esté editando a mano, en
      // cuyo caso solo "↻ Regenerar" lo vuelve a pisar.
      const scriptPreview = document.getElementById("script-preview") as HTMLTextAreaElement;
      let scriptEdited = false;
      scriptPreview.addEventListener("input", () => {
        scriptEdited = true;
      });

      function refreshScriptPreview() {
        if (scriptEdited) return;
        const selection = currentSelection();
        const total = selection.tweaks.length + selection.apps.length + selection.tools.length;
        scriptPreview.value =
          total === 0
            ? "Selecciona algún tweak, app o herramienta para ver el script aquí."
            : buildScript(selection);
      }

      document.querySelectorAll("[data-panel-target]").forEach((item) => {
        item.addEventListener("click", () => {
          document.querySelectorAll("[data-panel-target]").forEach((i) => i.classList.remove("active"));
          item.classList.add("active");
          const target = (item as HTMLElement).dataset.panelTarget;
          document.querySelectorAll("[data-panel]").forEach((panel) => {
            (panel as HTMLElement).hidden = (panel as HTMLElement).dataset.panel !== target;
          });
          if (target === "script") refreshScriptPreview();
          if (target === "apps") refreshAppStatuses();
          if (target === "services") loadServices();
          if (target === "installed-apps") loadInstalledApps();
          if (target?.startsWith("cat-")) refreshTweakStatuses(target.replace("cat-", ""));
          if (target === "inicio") startMetricsPolling();
          else stopMetricsPolling();
        });
      });

      function updateActionBar() {
        const count = selectedTweaks.size + selectedApps.size + selectedTools.size;
        const countEl = document.getElementById("selection-count")!;
        const button = document.getElementById("action-button") as HTMLButtonElement;
        countEl.textContent = `${count} seleccionado${count === 1 ? "" : "s"}`;
        button.disabled = count === 0;
        button.textContent = desktopMode
          ? `Aplicar ${count} cambio${count === 1 ? "" : "s"}`
          : `Descargar script (${count} cambio${count === 1 ? "" : "s"})`;
        refreshScriptPreview();
      }

      function wireCheckboxes(selector: string, set: Set<string>, dataKey: string) {
        document.querySelectorAll<HTMLInputElement>(selector).forEach((el) => {
          el.addEventListener("change", () => {
            const id = (el.dataset as Record<string, string | undefined>)[dataKey]!;
            if (el.checked) set.add(id);
            else set.delete(id);
            updateActionBar();
          });
        });
      }

      wireCheckboxes("[data-select-tweak]", selectedTweaks, "selectTweak");
      wireCheckboxes("[data-select-app]", selectedApps, "selectApp");
      wireCheckboxes("[data-select-tool]", selectedTools, "selectTool");

      function uncheckAll() {
        selectedTweaks.clear();
        selectedApps.clear();
        selectedTools.clear();
        document
          .querySelectorAll<HTMLInputElement>("[data-select-tweak], [data-select-app], [data-select-tool]")
          .forEach((el) => (el.checked = false));
        updateActionBar();
      }

      document.getElementById("uncheck-all")!.addEventListener("click", uncheckAll);

      function selectIds(ids: string[], set: Set<string>, selector: (id: string) => string) {
        for (const id of ids) {
          set.add(id);
          const el = document.querySelector<HTMLInputElement>(selector(id));
          if (el) el.checked = true;
        }
      }

      document.querySelectorAll<HTMLButtonElement>("[data-apply-preset]").forEach((button) => {
        button.addEventListener("click", () => {
          const preset = presets.find((p) => p.id === button.dataset.applyPreset);
          if (!preset) return;

          uncheckAll();
          selectIds(preset.tweaks, selectedTweaks, (id) => `[data-select-tweak="${id}"]`);
          selectIds(preset.apps, selectedApps, (id) => `[data-select-app="${id}"]`);
          selectIds(preset.tools, selectedTools, (id) => `[data-select-tool="${id}"]`);
          updateActionBar();

          document.querySelector<HTMLElement>('[data-panel-target="script"]')?.click();
        });
      });

      // Estado en vivo (solo modo desktop): consulta perezosa, una vez por
      // panel, para no lanzar una llamada a PowerShell por cada tweak/app en
      // cada carga de página.
      const checkedPanels = new Set<string>();

      async function refreshTweakStatuses(category: string, force = false) {
        if (!desktopMode) return;
        if (checkedPanels.has(`cat-${category}`) && !force) return;
        checkedPanels.add(`cat-${category}`);

        for (const tweak of tweaks.filter((t) => t.category === category)) {
          const badge = document.querySelector<HTMLElement>(`[data-status-tweak="${tweak.id}"]`);
          if (!badge) continue;
          badge.hidden = false;
          badge.textContent = "…";
          try {
            const applied = await desktop.getTweakStatus(tweak.id);
            badge.textContent = applied ? "Aplicado" : "No aplicado";
          } catch {
            badge.textContent = "?";
          }
        }
      }

      async function refreshAppStatuses(force = false) {
        if (!desktopMode) return;
        if (checkedPanels.has("apps") && !force) return;
        checkedPanels.add("apps");

        for (const app of apps) {
          const badge = document.querySelector<HTMLElement>(`[data-status-app="${app.id}"]`);
          if (!badge) continue;
          badge.hidden = false;
          badge.textContent = "…";
          try {
            const installed = await desktop.getAppStatus(app.id, preferredManager(app));
            badge.textContent = installed ? "Instalada" : "No instalada";
          } catch {
            badge.textContent = "?";
          }
        }
      }

      document.querySelectorAll<HTMLButtonElement>("[data-refresh-status]").forEach((button) => {
        button.addEventListener("click", (e) => {
          e.stopPropagation();
          const target = button.dataset.refreshStatus!;
          if (target === "apps") refreshAppStatuses(true);
          else refreshTweakStatuses(target.replace("cat-", ""), true);
        });
      });

      function exportProfile() {
        const selection = {
          tweaks: [...selectedTweaks],
          apps: [...selectedApps],
          tools: [...selectedTools],
        };
        const blob = new Blob([JSON.stringify(selection, null, 2)], { type: "application/json" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = "rck-perfil.json";
        a.click();
        URL.revokeObjectURL(url);
      }

      async function importProfile(file: File) {
        const text = await file.text();
        const parsed = JSON.parse(text) as { tweaks?: string[]; apps?: string[]; tools?: string[] };

        uncheckAll();
        selectIds(parsed.tweaks ?? [], selectedTweaks, (id) => `[data-select-tweak="${id}"]`);
        selectIds(parsed.apps ?? [], selectedApps, (id) => `[data-select-app="${id}"]`);
        selectIds(parsed.tools ?? [], selectedTools, (id) => `[data-select-tool="${id}"]`);
        updateActionBar();
      }

      document.getElementById("export-profile")!.addEventListener("click", exportProfile);

      document.getElementById("import-profile")!.addEventListener("click", () => {
        document.getElementById("import-profile-input")!.click();
      });

      document.getElementById("import-profile-input")!.addEventListener("change", async (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (file) await importProfile(file);
      });

      function exportWinScript() {
        const profile = exportWinScriptProfile({ tweaks: [...selectedTweaks], apps: [...selectedApps] });
        const blob = new Blob([JSON.stringify(profile, null, 2)], { type: "application/json" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = "rck-winscript.json";
        a.click();
        URL.revokeObjectURL(url);
      }

      async function importWinScript(file: File) {
        const text = await file.text();
        const parsed = JSON.parse(text);

        if (!isWinScriptProfile(parsed)) {
          alert("Ese archivo no parece un perfil de WinScript (se esperaba un objeto plano de claves true/false).");
          return;
        }

        const result = importWinScriptProfile(parsed);

        uncheckAll();
        selectIds(result.tweaks, selectedTweaks, (id) => `[data-select-tweak="${id}"]`);
        selectIds(result.apps, selectedApps, (id) => `[data-select-app="${id}"]`);
        updateActionBar();

        const lines = [
          `Importado desde WinScript: ${result.matchedKeys.length} clave(s) reconocida(s) -> ${result.tweaks.length} tweak(s) + ${result.apps.length} app(s).`,
        ];
        if (result.protectedKeys.length > 0) {
          lines.push(
            `Omitidas por protección (ver docs/BLACKLIST.md): ${result.protectedKeys.join(", ")}.`
          );
        }
        if (result.unsupportedKeys.length > 0) {
          lines.push(`Sin equivalente todavía en RCK (${result.unsupportedKeys.length}): ${result.unsupportedKeys.join(", ")}.`);
        }
        alert(lines.join("\n\n"));

        document.querySelector<HTMLElement>('[data-panel-target="script"]')?.click();
      }

      document.getElementById("export-winscript")!.addEventListener("click", exportWinScript);

      document.getElementById("import-winscript")!.addEventListener("click", () => {
        document.getElementById("import-winscript-input")!.click();
      });

      document.getElementById("import-winscript-input")!.addEventListener("change", async (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (file) await importWinScript(file);
        (e.target as HTMLInputElement).value = "";
      });

      document.getElementById("copy-script")!.addEventListener("click", async () => {
        await navigator.clipboard.writeText(scriptPreview.value);
      });

      document.getElementById("download-script")!.addEventListener("click", () => {
        downloadScript(scriptPreview.value);
      });

      document.getElementById("regenerate-script")!.addEventListener("click", () => {
        scriptEdited = false;
        refreshScriptPreview();
      });

      const runScriptButton = document.getElementById("run-script") as HTMLButtonElement;
      const runScriptWarning = document.getElementById("run-script-warning")!;
      const runScriptOutput = document.getElementById("run-script-output")!;

      if (desktopMode) {
        runScriptButton.hidden = false;
        runScriptWarning.hidden = false;
      }

      runScriptButton.addEventListener("click", async () => {
        if (!confirm("Esto va a ejecutar el script tal cual está escrito arriba, con permisos de administrador. ¿Continuar?")) {
          return;
        }
        runScriptButton.disabled = true;
        runScriptButton.textContent = "Ejecutando...";
        runScriptOutput.hidden = false;
        runScriptOutput.textContent = "Ejecutando...";
        try {
          const output = await desktop.runRawScript(scriptPreview.value);
          runScriptOutput.textContent = output.trim() || "(el script no imprimió nada por consola)";
        } catch (err) {
          runScriptOutput.textContent = `Error: ${err}`;
        } finally {
          runScriptButton.disabled = false;
          runScriptButton.textContent = "▶ Ejecutar en este PC";
        }
      });

      document.getElementById("action-button")!.addEventListener("click", async () => {
        const selection = currentSelection();

        if (desktopMode) {
          await desktop.createRestorePoint("RCK - aplicando cambios seleccionados");
          for (const tweak of selection.tweaks) {
            await desktop.applyTweak(tweak.id);
          }
          for (const { app, manager } of selection.apps) {
            await desktop.installApp(app.id, manager);
          }
          for (const tool of selection.tools) {
            await desktop.runTool(tool.id);
          }
          alert("Cambios aplicados.");
        } else {
          downloadScript(buildScript(selection));
        }
      });

      // Dashboard: info del sistema (solo disponible en modo desktop).
      async function loadSystemInfo() {
        const statusEl = document.getElementById("system-info-status")!;
        const grid = document.getElementById("system-info-grid")!;

        if (!desktopMode) {
          statusEl.textContent = "Solo disponible en la app de escritorio";
          ["metric-cpu", "metric-ram", "metric-network"].forEach((id) => {
            document.getElementById(id)!.textContent = "N/D (web)";
          });
          return;
        }

        try {
          const info = await desktop.getSystemInfo();
          grid.innerHTML = `
            <div class="stat-card"><div class="stat-card__label">💻 Equipo</div><div class="stat-card__value">${info.computer_name}</div></div>
            <div class="stat-card"><div class="stat-card__label">🪟 Windows</div><div class="stat-card__value">${info.os_caption} (build ${info.os_build})</div></div>
            <div class="stat-card"><div class="stat-card__label">🧠 CPU</div><div class="stat-card__value">${info.cpu_name}</div></div>
            <div class="stat-card"><div class="stat-card__label">🎮 GPU</div><div class="stat-card__value">${info.gpu_name}</div></div>
            <div class="stat-card"><div class="stat-card__label">📊 RAM</div><div class="stat-card__value">${info.ram_total_gb} GB</div></div>
          `;
        } catch (err) {
          statusEl.textContent = "No se pudo leer la información del sistema";
          console.error(err);
        }
      }

      // Medidores en vivo (CPU/RAM/Red): solo mientras el panel "Inicio"
      // está visible, para no seguir consultando en segundo plano cuando el
      // usuario está en otra sección.
      let metricsInterval: ReturnType<typeof setInterval> | undefined;

      function formatBytesPerSec(bytes: number): string {
        if (bytes < 1024) return `${bytes} B/s`;
        if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB/s`;
        return `${(bytes / 1024 / 1024).toFixed(1)} MB/s`;
      }

      async function pollLiveMetrics() {
        try {
          const m = await desktop.getLiveMetrics();
          document.getElementById("metric-cpu")!.textContent = `${m.cpu_percent.toFixed(0)}%`;
          document.getElementById("metric-ram")!.textContent =
            `${m.ram_percent.toFixed(0)}% (${m.ram_used_gb.toFixed(1)}/${m.ram_total_gb.toFixed(1)} GB)`;
          document.getElementById("metric-network")!.textContent =
            `↓ ${formatBytesPerSec(m.network_down_bytes_per_sec)} · ↑ ${formatBytesPerSec(m.network_up_bytes_per_sec)}`;
        } catch (err) {
          console.error("No se pudieron leer las métricas en vivo:", err);
        }
      }

      function startMetricsPolling() {
        if (!desktopMode || metricsInterval) return;
        pollLiveMetrics();
        metricsInterval = setInterval(pollLiveMetrics, 1000);
      }

      function stopMetricsPolling() {
        if (metricsInterval) {
          clearInterval(metricsInterval);
          metricsInterval = undefined;
        }
      }

      // Servicios: lectura en vivo (no forma parte del catálogo firmado).
      let servicesLoaded = false;

      function renderServiceRow(svc: { name: string; display_name: string; status: string; start_type: string }) {
        const startTypes = ["Automatic", "Manual", "Disabled"];
        const labels: Record<string, string> = { Automatic: "Automático", Manual: "Manual", Disabled: "Deshabilitado" };
        const options = startTypes
          .map((t) => `<option value="${t}" ${t === svc.start_type ? "selected" : ""}>${labels[t]}</option>`)
          .join("");
        return `
          <div class="tweak-card" data-service-row data-service-search="${(svc.display_name + " " + svc.name).toLowerCase()}">
            <div class="tweak-card__body">
              <div class="tweak-card__title">${svc.display_name}</div>
              <div class="tweak-card__meta">
                <span class="risk-badge risk-badge--neutral">${svc.name}</span>
                <span class="risk-badge risk-badge--neutral">${svc.status}</span>
              </div>
            </div>
            <div class="tweak-card__actions">
              <select class="services-select" data-service-select="${svc.name}">${options}</select>
            </div>
          </div>`;
      }

      async function loadServices(force = false) {
        if (servicesLoaded && !force) return;
        if (!desktopMode) {
          document.getElementById("services-list")!.innerHTML =
            '<p style="color: var(--text-dim);">Solo disponible en la app de escritorio.</p>';
          return;
        }

        const list = document.getElementById("services-list")!;
        const count = document.getElementById("services-count")!;
        list.innerHTML = '<p style="color: var(--text-dim);">Cargando servicios...</p>';

        try {
          const services = await desktop.listServices();
          servicesLoaded = true;
          list.innerHTML = services.map(renderServiceRow).join("");
          count.insertAdjacentHTML("afterbegin", `<span style="margin-right: 0.75rem;">${services.length} servicios</span>`);

          list.querySelectorAll<HTMLSelectElement>("[data-service-select]").forEach((select) => {
            const previousValue = select.value;
            select.addEventListener("change", async () => {
              const name = select.dataset.serviceSelect!;
              const newValue = select.value;
              select.disabled = true;
              try {
                await desktop.setServiceStartup(name, newValue);
              } catch (err) {
                alert(String(err));
                select.value = previousValue;
              } finally {
                select.disabled = false;
              }
            });
          });
        } catch (err) {
          list.innerHTML = `<p style="color: var(--text-dim);">No se pudo cargar la lista de servicios: ${err}</p>`;
        }
      }

      document.getElementById("services-refresh")!.addEventListener("click", () => loadServices(true));

      document.getElementById("services-search")!.addEventListener("input", (e) => {
        const query = (e.target as HTMLInputElement).value.trim().toLowerCase();
        document.querySelectorAll<HTMLElement>("[data-service-row]").forEach((row) => {
          row.hidden = query.length > 0 && !(row.dataset.serviceSearch ?? "").includes(query);
        });
      });

      // Apps instaladas: lectura en vivo del registro (no forma parte del
      // catálogo de apps instalables). El comando de desinstalación no se
      // guarda en el DOM (podría llevar comillas/caracteres raros) — se
      // referencia por índice a esta caché en memoria.
      let installedAppsLoaded = false;
      let installedAppsCache: import("../lib/types").InstalledApp[] = [];

      function escapeHtml(str: string): string {
        return str.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);
      }

      function renderInstalledAppRow(appInfo: import("../lib/types").InstalledApp, index: number): string {
        const meta = [appInfo.version, appInfo.publisher, appInfo.size_mb ? `${appInfo.size_mb.toFixed(0)} MB` : null]
          .filter(Boolean)
          .map((v) => `<span class="risk-badge risk-badge--neutral">${escapeHtml(String(v))}</span>`)
          .join("");
        const canUninstall = Boolean(appInfo.uninstall_command);
        return `
          <div class="tweak-card" data-installed-app-row data-installed-app-search="${escapeHtml((appInfo.name + " " + (appInfo.publisher ?? "")).toLowerCase())}">
            <div class="tweak-card__body">
              <div class="tweak-card__title">${escapeHtml(appInfo.name)}</div>
              <div class="tweak-card__meta">${meta}</div>
            </div>
            <div class="tweak-card__actions">
              <button class="button" data-uninstall-index="${index}" ${canUninstall ? "" : "disabled"}>
                🗑️ Desinstalar
              </button>
            </div>
          </div>`;
      }

      async function loadInstalledApps(force = false) {
        if (installedAppsLoaded && !force) return;
        const list = document.getElementById("installed-apps-list")!;
        const count = document.getElementById("installed-apps-count")!;

        if (!desktopMode) {
          list.innerHTML = '<p style="color: var(--text-dim);">Solo disponible en la app de escritorio.</p>';
          return;
        }

        list.innerHTML = '<p style="color: var(--text-dim);">Cargando apps instaladas...</p>';

        try {
          installedAppsCache = await desktop.listInstalledApps();
          installedAppsLoaded = true;
          list.innerHTML = installedAppsCache.map((a, i) => renderInstalledAppRow(a, i)).join("");
          count.insertAdjacentHTML(
            "afterbegin",
            `<span style="margin-right: 0.75rem;">${installedAppsCache.length} apps</span>`
          );

          list.querySelectorAll<HTMLButtonElement>("[data-uninstall-index]").forEach((button) => {
            button.addEventListener("click", async () => {
              const target = installedAppsCache[Number(button.dataset.uninstallIndex)];
              if (!target?.uninstall_command) return;
              if (!confirm(`¿Desinstalar "${target.name}"? Esto ejecuta el desinstalador original del programa.`)) {
                return;
              }
              button.disabled = true;
              button.textContent = "Desinstalando...";
              try {
                await desktop.uninstallInstalledApp(target.uninstall_command);
                await loadInstalledApps(true);
              } catch (err) {
                alert(`No se pudo desinstalar "${target.name}": ${err}`);
                button.disabled = false;
                button.textContent = "🗑️ Desinstalar";
              }
            });
          });
        } catch (err) {
          list.innerHTML = `<p style="color: var(--text-dim);">No se pudo cargar la lista de apps instaladas: ${err}</p>`;
        }
      }

      document.getElementById("installed-apps-refresh")!.addEventListener("click", () => loadInstalledApps(true));

      document.getElementById("installed-apps-search")!.addEventListener("input", (e) => {
        const query = (e.target as HTMLInputElement).value.trim().toLowerCase();
        document.querySelectorAll<HTMLElement>("[data-installed-app-row]").forEach((row) => {
          row.hidden = query.length > 0 && !(row.dataset.installedAppSearch ?? "").includes(query);
        });
      });

      loadSystemInfo();
      startMetricsPolling();
      updateActionBar();
    </script>
  </body>
</html>
