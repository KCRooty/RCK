---
import "../styles/global.css";
import {
  TWEAK_CATEGORIES,
  APP_SUBCATEGORIES,
  tweaksByCategory,
  appsBySubcategory,
  tools,
} from "../lib/catalog";

const CATEGORY_LABELS: Record<string, string> = {
  debloat: "Debloat",
  privacy: "Privacidad",
  performance: "Rendimiento",
  services: "Servicios",
  network: "Red",
  appearance: "Apariencia",
  updates: "Actualizaciones",
  system: "Sistema",
};

const CATEGORY_ICONS: Record<string, string> = {
  debloat: "🧹",
  privacy: "🔒",
  performance: "⚡",
  services: "⚙️",
  network: "🌐",
  appearance: "🎨",
  updates: "🔄",
  system: "🖥️",
};

const SUBCATEGORY_LABELS: Record<string, string> = {
  browsers: "Navegadores",
  "dev-tools": "Herramientas de desarrollo",
  utilities: "Utilidades",
  media: "Multimedia",
  communication: "Comunicación",
};
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>RCK — Constructor</title>
  </head>
  <body>
    <div class="layout">
      <aside class="sidebar">
        <div class="sidebar__brand">🛡️ RCK</div>
        <button class="sidebar__uncheck" id="uncheck-all">Desmarcar todo</button>

        <div class="sidebar__item active" data-panel-target="inicio">
          <span class="sidebar__item-icon">🏠</span> Inicio
        </div>

        <div class="sidebar__section-label">Tweaks</div>
        {TWEAK_CATEGORIES.map((cat) => (
          <div class="sidebar__item" data-panel-target={`cat-${cat}`}>
            <span class="sidebar__item-icon">{CATEGORY_ICONS[cat]}</span> {CATEGORY_LABELS[cat]}
          </div>
        ))}

        <div class="sidebar__section-label">Extras</div>
        <div class="sidebar__item" data-panel-target="apps">
          <span class="sidebar__item-icon">📦</span> Apps
        </div>
        <div class="sidebar__item" data-panel-target="tools">
          <span class="sidebar__item-icon">🛠️</span> Herramientas
        </div>
        <div class="sidebar__item" data-panel-target="script">
          <span class="sidebar__item-icon">📜</span> Ver Script
        </div>
      </aside>

      <main class="main">
        <!-- Inicio -->
        <section class="panel" data-panel="inicio">
          <div class="main__header">
            <h1>Inicio</h1>
          </div>
          <div class="stat-grid" id="system-info-grid">
            <div class="stat-card">
              <div class="stat-card__label">Estado</div>
              <div class="stat-card__value" id="system-info-status">Cargando…</div>
            </div>
          </div>
          <div class="stat-grid">
            <div class="stat-card">
              <div class="stat-card__label">🧩 Tweaks disponibles</div>
              <div class="stat-card__value">{TWEAK_CATEGORIES.map((c) => tweaksByCategory(c).length).reduce((a, b) => a + b, 0)}</div>
            </div>
            <div class="stat-card">
              <div class="stat-card__label">📦 Apps disponibles</div>
              <div class="stat-card__value">{APP_SUBCATEGORIES.map((s) => appsBySubcategory(s).length).reduce((a, b) => a + b, 0)}</div>
            </div>
            <div class="stat-card">
              <div class="stat-card__label">🛠️ Herramientas</div>
              <div class="stat-card__value">{tools.length}</div>
            </div>
          </div>
          <p style="color: var(--text-dim);">
            Elige una categoría en la barra lateral para empezar. Todo lo que marques se puede revisar en
            <strong>Ver Script</strong> antes de aplicarlo.
          </p>
        </section>

        <!-- Categorías de tweaks -->
        {TWEAK_CATEGORIES.map((cat) => (
          <section class="panel" data-panel={`cat-${cat}`} hidden>
            <div class="main__header">
              <h1>{CATEGORY_ICONS[cat]} {CATEGORY_LABELS[cat]}</h1>
              <span class="main__count">{tweaksByCategory(cat).length} tweak(s)</span>
            </div>
            <div class="tweak-list">
              {tweaksByCategory(cat).length === 0 && <p style="color: var(--text-dim);">Todavía no hay tweaks en esta categoría.</p>}
              {tweaksByCategory(cat).map((tweak) => (
                <div class="tweak-card" data-tweak-id={tweak.id}>
                  <div class="tweak-card__body">
                    <strong>
                      {tweak.id}
                      <span class={`risk-badge risk-badge--${tweak.risk}`}>{tweak.risk}</span>
                      {tweak.requires_restart && <span class="risk-badge risk-badge--neutral">requiere reinicio</span>}
                    </strong>
                    <p style="color: var(--text-dim); margin: 0.25rem 0 0;">{tweak.description}</p>
                  </div>
                  <div class="tweak-card__actions">
                    <label class="switch">
                      <input type="checkbox" data-select-tweak={tweak.id} />
                      <span class="switch__track"></span>
                    </label>
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))}

        <!-- Apps -->
        <section class="panel" data-panel="apps" hidden>
          <div class="main__header">
            <h1>📦 Apps</h1>
          </div>
          {APP_SUBCATEGORIES.map((sub) => (
            <div>
              <h3>{SUBCATEGORY_LABELS[sub]}</h3>
              <div class="tweak-list">
                {appsBySubcategory(sub).map((app) => (
                  <div class="tweak-card" data-app-id={app.id}>
                    <div class="tweak-card__body">
                      <strong>{app.name}</strong>
                      <p style="color: var(--text-dim); margin: 0.25rem 0 0;">{app.description}</p>
                    </div>
                    <div class="tweak-card__actions">
                      <label class="switch">
                        <input type="checkbox" data-select-app={app.id} />
                        <span class="switch__track"></span>
                      </label>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </section>

        <!-- Herramientas -->
        <section class="panel" data-panel="tools" hidden>
          <div class="main__header">
            <h1>🛠️ Herramientas</h1>
            <span class="main__count">Acciones puntuales, sin estado</span>
          </div>
          <div class="tweak-list">
            {tools.map((tool) => (
              <div class="tweak-card" data-tool-id={tool.id}>
                <div class="tweak-card__body">
                  <strong>
                    {tool.name}
                    <span class={`risk-badge risk-badge--${tool.risk}`}>{tool.risk}</span>
                  </strong>
                  <p style="color: var(--text-dim); margin: 0.25rem 0 0;">{tool.description}</p>
                </div>
                <div class="tweak-card__actions">
                  <label class="switch">
                    <input type="checkbox" data-select-tool={tool.id} />
                    <span class="switch__track"></span>
                  </label>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Ver Script -->
        <section class="panel" data-panel="script" hidden>
          <div class="main__header">
            <h1>📜 Ver Script</h1>
          </div>
          <p style="color: var(--text-dim);">
            Así se ve el <code>.ps1</code> que se generaría con tu selección actual — igual se aplique en vivo (desktop) o se descargue (web).
          </p>
          <div class="tweak-card__actions" style="margin-bottom: 0.75rem;">
            <button class="button" id="copy-script">Copiar</button>
            <button class="button" id="download-script">Descargar .ps1</button>
          </div>
          <pre class="script-preview" id="script-preview">Selecciona algún tweak, app o herramienta para ver el script aquí.</pre>
        </section>

        <div class="action-bar" id="action-bar">
          <span id="selection-count">0 seleccionados</span>
          <button id="action-button" disabled>Selecciona al menos un elemento</button>
        </div>
      </main>
    </div>

    <script>
      import { isDesktop } from "../lib/runtime";
      import { tweaks, apps, tools } from "../lib/catalog";
      import { buildScript, downloadScript } from "../lib/scriptBuilder";
      import { desktop } from "../lib/tauriClient";

      const desktopMode = isDesktop();
      const selectedTweaks = new Set<string>();
      const selectedApps = new Set<string>();
      const selectedTools = new Set<string>();

      function currentSelection() {
        return {
          tweaks: tweaks.filter((t) => selectedTweaks.has(t.id)),
          apps: apps
            .filter((a) => selectedApps.has(a.id))
            .map((app) => ({ app, manager: (app.winget ? "winget" : "choco") as "winget" | "choco" })),
          tools: tools.filter((t) => selectedTools.has(t.id)),
        };
      }

      function refreshScriptPreview() {
        const preview = document.getElementById("script-preview")!;
        const selection = currentSelection();
        const total = selection.tweaks.length + selection.apps.length + selection.tools.length;
        preview.textContent =
          total === 0
            ? "Selecciona algún tweak, app o herramienta para ver el script aquí."
            : buildScript(selection);
      }

      document.querySelectorAll("[data-panel-target]").forEach((item) => {
        item.addEventListener("click", () => {
          document.querySelectorAll("[data-panel-target]").forEach((i) => i.classList.remove("active"));
          item.classList.add("active");
          const target = (item as HTMLElement).dataset.panelTarget;
          document.querySelectorAll("[data-panel]").forEach((panel) => {
            (panel as HTMLElement).hidden = (panel as HTMLElement).dataset.panel !== target;
          });
          if (target === "script") refreshScriptPreview();
        });
      });

      function updateActionBar() {
        const count = selectedTweaks.size + selectedApps.size + selectedTools.size;
        const countEl = document.getElementById("selection-count")!;
        const button = document.getElementById("action-button") as HTMLButtonElement;
        countEl.textContent = `${count} seleccionado${count === 1 ? "" : "s"}`;
        button.disabled = count === 0;
        button.textContent = desktopMode
          ? `Aplicar ${count} cambio${count === 1 ? "" : "s"}`
          : `Descargar script (${count} cambio${count === 1 ? "" : "s"})`;
        refreshScriptPreview();
      }

      function wireCheckboxes(selector: string, set: Set<string>, dataKey: string) {
        document.querySelectorAll<HTMLInputElement>(selector).forEach((el) => {
          el.addEventListener("change", () => {
            const id = (el.dataset as Record<string, string | undefined>)[dataKey]!;
            if (el.checked) set.add(id);
            else set.delete(id);
            updateActionBar();
          });
        });
      }

      wireCheckboxes("[data-select-tweak]", selectedTweaks, "selectTweak");
      wireCheckboxes("[data-select-app]", selectedApps, "selectApp");
      wireCheckboxes("[data-select-tool]", selectedTools, "selectTool");

      document.getElementById("uncheck-all")!.addEventListener("click", () => {
        selectedTweaks.clear();
        selectedApps.clear();
        selectedTools.clear();
        document
          .querySelectorAll<HTMLInputElement>("[data-select-tweak], [data-select-app], [data-select-tool]")
          .forEach((el) => (el.checked = false));
        updateActionBar();
      });

      document.getElementById("copy-script")!.addEventListener("click", async () => {
        const text = document.getElementById("script-preview")!.textContent ?? "";
        await navigator.clipboard.writeText(text);
      });

      document.getElementById("download-script")!.addEventListener("click", () => {
        downloadScript(buildScript(currentSelection()));
      });

      document.getElementById("action-button")!.addEventListener("click", async () => {
        const selection = currentSelection();

        if (desktopMode) {
          await desktop.createRestorePoint("RCK - aplicando cambios seleccionados");
          for (const tweak of selection.tweaks) {
            await desktop.applyTweak(tweak.id);
          }
          for (const { app, manager } of selection.apps) {
            await desktop.installApp(app.id, manager);
          }
          for (const tool of selection.tools) {
            await desktop.runTool(tool.id);
          }
          alert("Cambios aplicados.");
        } else {
          downloadScript(buildScript(selection));
        }
      });

      // Dashboard: info del sistema (solo disponible en modo desktop).
      async function loadSystemInfo() {
        const statusEl = document.getElementById("system-info-status")!;
        const grid = document.getElementById("system-info-grid")!;

        if (!desktopMode) {
          statusEl.textContent = "Solo disponible en la app de escritorio";
          return;
        }

        try {
          const info = await desktop.getSystemInfo();
          grid.innerHTML = `
            <div class="stat-card"><div class="stat-card__label">💻 Equipo</div><div class="stat-card__value">${info.computer_name}</div></div>
            <div class="stat-card"><div class="stat-card__label">🪟 Windows</div><div class="stat-card__value">${info.os_caption} (build ${info.os_build})</div></div>
            <div class="stat-card"><div class="stat-card__label">🧠 CPU</div><div class="stat-card__value">${info.cpu_name}</div></div>
            <div class="stat-card"><div class="stat-card__label">🎮 GPU</div><div class="stat-card__value">${info.gpu_name}</div></div>
            <div class="stat-card"><div class="stat-card__label">📊 RAM</div><div class="stat-card__value">${info.ram_total_gb} GB</div></div>
          `;
        } catch (err) {
          statusEl.textContent = "No se pudo leer la información del sistema";
          console.error(err);
        }
      }

      loadSystemInfo();
      updateActionBar();
    </script>
  </body>
</html>
